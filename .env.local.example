# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# eBay Developer Program (developer.ebay.com -> Application Keys)
# Use "production" keys for a live account, "sandbox" keys for testing.
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=http://localhost:3000/api/ebay/callback
# RuName from the eBay Developer Portal (Redirect URL name), required for the
# hosted eBay consent page even though EBAY_REDIRECT_URI is where eBay sends
# the user back after they approve access.
EBAY_RU_NAME=

# Random secret used to sign the OAuth "state" param (any long random string)
EBAY_OAUTH_STATE_SECRET=

# Used to build absolute callback URLs when not on localhost
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: shared secret required on the /api/cron/sync route so only your
# scheduler (e.g. Vercel Cron, GitHub Actions) can trigger it.
CRON_SECRET=
